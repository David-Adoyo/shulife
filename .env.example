# Copy to apps/web/.env.local. Never commit real values. Values in {{…}} come from the placeholder register (docs/MASTERPLAN.md §19).

# Supabase (database, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_…   # the publishable key
SUPABASE_SECRET_KEY=sb_secret_…                 # the secret key — server only, never in the browser

# Signed parent links (long random string)
PARENT_TOKEN_SECRET=

# Phone hashing salt for payment matching (long random string, never rotate without re-hashing)
PHONE_HASH_SALT=

# M-Pesa: per-campus callback secrets live in payment_integrations; Daraja keys in Supabase Vault.
SAFARICOM_CALLBACK_IPS=            # {{SAFARICOM_CALLBACK_IPS}}, comma-separated (optional allow-list)

# Africa's Talking SMS
AT_USERNAME=
AT_API_KEY=
SMS_SENDER_ID=SHULIFE              # {{SMS_SENDER_ID}} — needs approval

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Shulife's own subscription billing
PAYSTACK_SECRET_KEY=
SHULIFE_PAYBILL=                   # {{SHULIFE_PAYBILL}}

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Observability (no learner data in events)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Database (any Postgres with packages/db/migrations applied; Supabase in production)
DATABASE_URL=
SHULIFE_SEED_DEMO=                 # 1 = load the demo school into an empty database
SHULIFE_TODAY=                     # "now" for real dates; empty keeps the demo date (3 Feb 2027)

# Scheduled jobs (reminders every 15 minutes; see apps/web/vercel.json)
CRON_SECRET=
